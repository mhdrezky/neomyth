---
import JsonLd from "@/components/seo/JsonLd.astro";
import VoiceApp from "@/components/VoiceApp";
import ToolPageLayout from "@/layouts/ToolPageLayout.astro";
---

<ToolPageLayout
  title="Neo-Voice"
  description="Real-time voice assistant: your speech is transcribed with Whisper, answered by a local LLM, and read aloud with Kokoro TTS. Connects to the Neomyth API via WebSocket."
  canonical={new URL("/voice", import.meta.env.PUBLIC_SITE_URL ?? "http://localhost:4321").href}
>
  <JsonLd type="voice" slot="head" />

  <VoiceApp client:load />

  <noscript>
    <p class="mt-6 text-sm text-destructive">
      JavaScript is required for the live voice session. Ensure workers and the
      API server on port 5000 are running.
    </p>
  </noscript>
</ToolPageLayout>

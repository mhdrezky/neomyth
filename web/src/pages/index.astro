---
import { AuthorByline } from "@/components/AuthorByline";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import { ModuleCard } from "@/components/ModuleCard";
import { Separator } from "@/components/ui/separator";
import { siteConfig } from "@/config/site";
import { faqItems, modules } from "@/data/modules";
---

<BaseLayout
  title={`Welcome to ${siteConfig.name}`}
  description={siteConfig.description}
>
  <JsonLd type="home" />

  <main class="mx-auto flex min-h-screen max-w-5xl flex-col px-6 py-16">
    <header class="mb-12 text-center">
      <p class="mb-2 text-sm font-medium uppercase tracking-widest text-primary">
        Modular AI Toolkit
      </p>
      <h1 class="mb-3 text-4xl font-bold tracking-tight sm:text-5xl">
        Welcome to Neomyth
      </h1>
      <AuthorByline />
      <p class="mx-auto max-w-2xl text-lg text-muted-foreground">
        Neomyth is a modular AI toolkit. Pick a tool below — each module solves a
        focused problem with local or self-hosted models where possible.
      </p>
    </header>

    <section aria-labelledby="tools-heading" class="mb-16">
      <h2 id="tools-heading" class="mb-6 text-2xl font-semibold">
        AI Tools
      </h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {modules.map((mod) => (
          <ModuleCard module={mod} />
        ))}
      </div>
    </section>

    <Separator className="mb-12" />

    <section aria-labelledby="faq-heading" class="mb-8">
      <h2 id="faq-heading" class="mb-6 text-2xl font-semibold">
        Frequently asked questions
      </h2>
      <div class="space-y-6">
        {faqItems.map((item) => (
          <article>
            <h3 class="mb-2 text-lg font-medium">{item.question}</h3>
            <p class="text-muted-foreground">{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

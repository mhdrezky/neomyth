---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  backHref?: string;
  backLabel?: string;
  fullWidth?: boolean;
}

const {
  title,
  description,
  canonical,
  backHref = "/",
  backLabel = "← Back to Neomyth",
  fullWidth = false,
} = Astro.props;

const pageTitle = `${title} — Neomyth`;
const mainClass = fullWidth
  ? "flex flex-col h-screen overflow-hidden"
  : "mx-auto max-w-3xl px-6 py-8 pb-12";
---

<BaseLayout title={pageTitle} description={description} canonical={canonical}>
  <slot name="head" />

  <main class={mainClass}>
    {!fullWidth && (
      <nav class="mb-6">
        <a href={backHref} class="text-sm text-muted-foreground hover:text-primary">
          {backLabel}
        </a>
      </nav>
    )}

    {!fullWidth && (
      <header class="mb-6">
        <h1 class="mb-3 text-3xl font-bold tracking-tight">{title}</h1>
        <p class="text-muted-foreground">{description}</p>
      </header>
    )}

    <slot />
  </main>
</BaseLayout>

# Host port (container listens on 8000 internally)
PORT=5001

# Hugging Face model ID
LLM_MODEL=Qwen/Qwen3.5-0.8B

# OpenAI-compatible API model name
LLM_MODEL_ALIAS=qwen-3.5

# VRAM allocation (0.70–0.75 recommended when ~3.22GB VRAM remains)
LLM_GPU_MEMORY_UTILIZATION=0.8

# Limit context length (model defaults can reach 32k/128k tokens and use a lot of VRAM)
LLM_MAX_MODEL_LEN=2048

# Force vLLM to use the more stable V0 backend on 4GB GPUs
VLLM_VERSION=v0

# Optional: required for gated models on Hugging Face
HF_TOKEN=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

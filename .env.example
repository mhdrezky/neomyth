# API gateway
API_PORT=8080
API_HOST=0.0.0.0

# LLM worker (deploy/vllm-llm)
VLLM_BASE_URL=http://localhost:5001/v1
VLLM_MODEL=qwen-3.5
VLLM_MAX_TOKENS=256
VLLM_TEMPERATURE=0.7

# STT worker — pick ONE:
# deploy/whisper-stt/          tiny, port 5002 (low latency, CPU)
# deploy/whisper-large-v3/    large-v3-turbo, port 5004 (clearer, needs GPU)
STT_BASE_URL=http://localhost:5004

# TTS worker (deploy/kokoro-tts)
TTS_BASE_URL=http://localhost:5003
TTS_VOICE=af_sarah

# Voice: barge-in while AI is speaking/thinking (true/false). Default: false
VOICE_INTERRUPT_ENABLED=false
